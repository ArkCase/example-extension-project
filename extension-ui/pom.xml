<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.group</groupId>
        <artifactId>example-customer-extension-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>example-customer-extension-ui</artifactId>
    <packaging>war</packaging>

    <name>ArkCase Code - UI</name>
    <description>ArkCase Code UI for an Example Customer</description>

    <!-- TODO: Example dependency acm-base-ui/acm-foia-ui/acm-privacy-ui -->
    <dependencies>
        <dependency>
            <groupId>${arkcase.groupId}</groupId>
            <artifactId>acm-base-ui</artifactId>
            <type>jar</type>
            <classifier>source</classifier>
        </dependency>
    </dependencies>

    <!--
        The build process consists of the following steps, in the following build phases:

            initialize:
                - extract parent's sources artifact (dependency:unpack-dependencies)
            generate-sources:
                - overwrite from the local source directory (resources:copy-resources)
            process-sources:
                - $ yarn install (exec:exec)
            generate-resources:
                - $ grunt updateModulesConfig (exec:exec)
            process-resources:
                - generate source assembly for downstream use (assembly:single)
            compile:
                - $ grunt (exec:exec)
    -->
    <build>
        <plugins>
            <!--Extract the parent source UI component's sources into the build directory -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>initialize</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <!--TODO: artifactId can be base/foia/privacy-->
                            <includeArtifactIds>acm-base-ui</includeArtifactIds>
                            <includeGroupIds>${arkcase.groupId}</includeGroupIds>
                            <outputDirectory>${angular-build.dir}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>${maven-resources-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>generate-sources</phase>
                        <id>copy-local-sources</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${angular-build.dir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${angular-src.dir}</directory>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Run the build -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${maven-exec-plugin.version}</version>
                <executions>
                    <!-- Yarn and Grunt tasks -->
                    <execution>
                        <id>yarn-install</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${angular-build.dir}</workingDirectory>
                            <executable>yarn</executable>
                            <arguments>
                                <argument>install</argument>
                                <argument>--skip-integrity-check</argument>
                                <argument>--ignore-engines</argument>
                                <argument>--non-interactive</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Grunt merge modules config task -->
                    <execution>
                        <id>run-grunt-merge-config</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${angular-build.dir}</workingDirectory>
                            <executable>node_modules/.bin/grunt</executable>
                            <environmentVariables>
                                <NODE_ENV>${compile.mode}</NODE_ENV>
                                <DEST_PATH>${angular-build.dir}</DEST_PATH>
                            </environmentVariables>
                            <arguments>
                                <argument>updateModulesConfig</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Grunt build -->
                    <execution>
                        <id>run-grunt-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <workingDirectory>${angular-build.dir}</workingDirectory>
                            <executable>node_modules/.bin/grunt</executable>
                            <environmentVariables>
                                <NODE_ENV>${compile.mode}</NODE_ENV>
                                <DEST_PATH>${angular-build.dir}</DEST_PATH>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>${maven-war-plugin.version}</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <webResources>
                        <resource>
                            <directory>${angular-build.dir}</directory>
                            <targetPath>/</targetPath>
                            <includes>
                                <include>application.js</include>
                                <include>config.js</include>
                                <include>home.html</include>
                                <include>loader.gif</include>
                                <include>assets/**</include>
                                <include>branding/**</include>
                                <include>directives/**</include>
                                <include>filters/**</include>
                                <include>lib/**</include>
                                <include>modules/**</include>
                                <include>modules_config/**</include>
                                <include>node_modules/**</include>
                                <include>services/**</include>
                            </includes>
                        </resource>
                    </webResources>
                    <packagingExcludes>WEB-INF/lib/*.jar</packagingExcludes>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries>
                            <Build-Time>${maven.build.timestamp}</Build-Time>
                            <SCM-Branch>${scmBranch}</SCM-Branch>
                            <SCM-Revision>${commitHash}</SCM-Revision>
                            <SCM-Build-Time>${buildTimestamp}</SCM-Build-Time>
                            <GroupId>${project.groupId}</GroupId>
                            <ArtifactId>${project.artifactId}</ArtifactId>
                            <Version>${project.version}</Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>ui-dev</id>
            <dependencies>
                <dependency>
                    <groupId>${arkcase.groupId}</groupId>
                    <artifactId>ui-dev-tools</artifactId>
                    <version>${arkcase.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ui-dev-tools</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>unpack-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeGroupIds>${arkcase.groupId}</includeGroupIds>
                                    <includeArtifactIds>ui-dev-tools</includeArtifactIds>
                                    <outputDirectory>${angular-build.dir}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
